# Web
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_ALLOWED_EMAILS=

# Vercel Cron dispatches the GitHub Actions Collector workflow.
CRON_SECRET=
GITHUB_ACTIONS_DISPATCH_TOKEN=
GITHUB_REPOSITORY=coolspid-create/daily_report
GITHUB_COLLECTOR_WORKFLOW=collector.yml
GITHUB_COLLECTOR_REF=main

# Collector
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=
TEMP_FILE_DIR=.data/temporary-source-files
MAX_DOWNLOAD_BYTES=52428800
DEFAULT_REQUEST_DELAY_MS=1200
PLAYWRIGHT_ENABLED=true
TEMP_FILE_TTL_HOURS=48
PDF_PROCESSING_ATTEMPTS=3
PDF_OCR_ENABLED=false

# AI provider abstraction
# `openai`를 설정하면 ANALYSIS_API_KEY로 OpenAI Responses API를 호출합니다.
# 키가 없거나 호출이 실패하면 안전하게 추출식 요약으로 처리합니다.
ANALYSIS_PROVIDER=extractive
ANALYSIS_API_KEY=
ANALYSIS_MODEL=gpt-5-mini

# Storage and digest
DIGEST_BUCKET=digests
TEMP_BUCKET=temporary-source-files
MIRROR_BUCKET=mirrored-source-files

# Daily automation
AUTOMATION_TIMEZONE=Asia/Seoul
AUTOMATION_WINDOW_HOURS=168
AUTO_APPROVAL_ENABLED=false
AUTO_APPROVAL_POLICY_VERSION=2026-08-v1

# Telegram delivery
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DESTINATION_KEY=daily-report-main
TELEGRAM_MAX_ATTEMPTS=3
PUBLIC_WEB_URL=http://localhost:3000
